{
  "expo": {
    "name": "Smart Parking LTDD2",
    "slug": "smart-parking-ltdd2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 420,
          "resizeMode": "contain",
          "backgroundColor": "#0984e3"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ltdd2.smartparking",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.ltdd2.smartparking",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0984e3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
